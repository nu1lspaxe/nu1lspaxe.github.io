---
import { Icon } from 'astro-icon/components'
import { subscribeConfig } from '../../config'

interface Props {
  class?: string
}

const { class: className = '' } = Astro.props
const config = subscribeConfig
---

{config.enable && (
  <div class:list={[
    "relative transition overflow-hidden bg-[var(--license-block-bg)] py-5 px-6 rounded-xl",
    className
  ]}>
    <!-- Background Watermark Icon -->
    <Icon
      name="fa6-regular:envelope"
      class="transition text-[12rem] absolute pointer-events-none right-4 top-1/2 -translate-y-1/2 text-black/5 dark:text-white/5"
    />

    <div class="relative z-10 flex flex-col gap-3">
      <!-- Title & Icon -->
      <div class="flex items-center gap-2.5">
        <div class="transition h-8 w-8 rounded-lg bg-[var(--card-bg)] text-[var(--primary)] flex items-center justify-center shrink-0 shadow-sm">
          <Icon name="fa6-regular:envelope" class="text-base" />
        </div>
        <div class="text-lg font-bold text-black/85 dark:text-white/85">
          {config.title ?? 'Subscribe to New Posts'}
        </div>
      </div>

      <!-- Description -->
      <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed max-w-xl">
        {config.description ?? 'Get notified via email whenever a new article is published. No spam, unsubscribe anytime.'}
      </p>

      <!-- Form -->
      {config.formAction ? (
        <form
          action={config.formAction}
          method="POST"
          target="_blank"
          class="mt-2 flex flex-col sm:flex-row gap-2.5 max-w-lg"
        >
          <!-- Brevo Anti-Spam Honeypot Field -->
          <input
            type="text"
            name="email_address_check"
            value=""
            class="hidden"
            tabindex="-1"
            autocomplete="off"
          />
          <input type="hidden" name="locale" value="en" />
          <input type="hidden" name="html_type" value="simple" />

          <div class="relative flex-1">
            <input
              type="email"
              name="EMAIL"
              required
              placeholder={config.placeholder ?? 'Enter your email address...'}
              class="w-full h-11 px-4 rounded-xl text-sm transition-all
                     bg-black/[0.04] hover:bg-black/[0.06] focus:bg-black/[0.06]
                     dark:bg-white/5 dark:hover:bg-white/10 dark:focus:bg-white/10
                     text-black/80 dark:text-white/80 placeholder:text-black/35 dark:placeholder:text-white/35
                     outline-none border border-black/5 dark:border-white/5 focus:border-[var(--primary)]"
            />
          </div>

          <button
            type="submit"
            class="h-11 px-5 rounded-xl font-medium text-sm transition-all flex items-center justify-center gap-2 shrink-0
                   bg-[var(--primary)] text-white hover:opacity-90 active:scale-95 shadow-sm cursor-pointer"
          >
            <Icon name="fa6-solid:paper-plane" class="text-xs" />
            <span>{config.buttonText ?? 'Subscribe'}</span>
          </button>
        </form>
      ) : (
        <div class="mt-2 py-3 px-4 rounded-lg bg-black/[0.03] dark:bg-white/5 border border-dashed border-black/15 dark:border-white/15 text-xs text-black/50 dark:text-white/50">
          💡 <strong>Setup Notice:</strong> Brevo subscription is enabled, but the form action URL is not yet configured. Please paste your Brevo form URL into <code class="bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded font-mono text-[var(--primary)]">subscribeConfig.formAction</code> in <code class="bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded font-mono">src/config.ts</code>.
        </div>
      )}
    </div>
  </div>
)}
